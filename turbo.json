{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env"],
	"ui": "tui",
	"tasks": {
		"build": {
			"env": [
				"SERVER_API",
				"DASHBOARD_URL",
				"R2_ACCOUNT_ID",
				"R2_ACCESS_KEY_ID",
				"R2_SECRET_ACCESS_KEY",
				"R2_BUCKET_NAME",
				"R2_BUCKET_PREFIX"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"test:e2e": {}
	}
}
