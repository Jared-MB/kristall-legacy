{
	"name": "kristall-monorepo",
	"private": true,
	"scripts": {
		"dev": "turbo run dev",
		"start:server": "pnpm --filter @kristall/server start",
		"start:dashboard": "pnpm --filter @kristall/dashboard start",
		"dev:landing": "pnpm --filter @kristall/landing dev",
		"dev:dashboard": "pnpm --filter @kristall/dashboard dev",
		"dev:pos": "pnpm --filter @kristall/pos dev",
		"dev:server": "pnpm --filter @kristall/server dev",
		"dev:web": "pnpm --filter \"@kristall/landing\" --filter \"@kristall/server\" dev",
		"dev:core": "pnpm --filter @kristall/core dev",
		"build": "turbo run build",
		"build:landing": "pnpm --filter @kristall/landing build",
		"build:dashboard": "pnpm --filter @kristall/dashboard build",
		"build:pos": "pnpm --filter @kristall/pos build",
		"build:server": "pnpm --filter @kristall/server build",
		"clean": "turbo run clean",
		"test": "turbo run test --filter=@kristall/core --filter=@kristall/http",
		"test:e2e": "turbo run test:e2e --filter=@kristall/server",
		"test:ci": "turbo run test --filter=@kristall/core",
		"vitest": "pnpm vitest --filter=@kristall/core --filter=@kristall/http",
		"coverage": "pnpm --filter @kristall/core coverage",
		"format": "biome format --write .",
		"ui": "pnpm --filter @kristall/ui ui"
	},
	"devDependencies": {
		"@biomejs/biome": "1.6.3",
		"@changesets/cli": "2.27.9",
		"@kristall/typescript-config": "workspace:*",
		"@nestjs/cli": "^10.4.5",
		"turbo": "^2.3.3"
	},
	"packageManager": "pnpm@9.7.0"
}
