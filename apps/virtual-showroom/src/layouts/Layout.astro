---
import "@fontsource-variable/quicksand";
import "@fontsource/aboreto";
import "../styles/global.css";

import { actions } from "astro:actions";

import { generateTonesFromRGB, hexToRGB, rgbToHex } from "@kristall/core/utils/colors";
import { parseSubdomain } from "src/lib/subdomain";

const [shopName, shop] = parseSubdomain(Astro.url.hostname);

const { data: virtualShowroom, error } = await Astro.callAction(actions.getVirtualShowroom, {
	shop,
});

if (!virtualShowroom || error) {
	return Astro.redirect("/404");
}

const { virtualShowroomConfig } = virtualShowroom;
const tones = generateTonesFromRGB(hexToRGB(virtualShowroomConfig?.customColor ?? '#000000'));

const customStyle = {
	"--vs-custom-500": `${rgbToHex(tones['500'])};`,
	"--vs-custom-400": `${rgbToHex(tones['400'])};`,
	"--vs-custom-300": `${rgbToHex(tones['300'])};`,
	"--vs-custom-200": `${rgbToHex(tones['200'])};`,
	"--vs-custom-100": `${rgbToHex(tones['100'])};`
}

interface Props {
	className?: string;
}
const { className } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image" href={virtualShowroom?.image ?? "/favicon.svg"} />
		<title>{shopName}</title>
	</head>
	<body class="w-dvw" style={{ ...customStyle }}>
		<main class:list={["min-h-dvh flex flex-col relative", className]} >
			<slot/>
		</main>
		<footer class="p-6">
			<small class="text-sm">Powered by <a class="text-purple-500" href="https://kristall.app" target="_blank" rel="noopener noreferrer">Kristall</a>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: 'Quicksand Variable', sans-serif;
	}
</style>
