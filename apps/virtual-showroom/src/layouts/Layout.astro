---
import "@fontsource-variable/quicksand";
import "src/styles/global.css";

const location = Astro.url.hostname;
const shop = location.split(".")[0];
const parsedName = shop
	.split("-")
	.map((word) => word.charAt(0).toUpperCase() + word.slice(1));
const shopName = parsedName.join(" ");
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{shopName}</title>
	</head>
	<body class="w-dvw">
		<main class="min-h-dvh flex flex-col">
			<slot/>
		</main>
		<footer class="p-6">
			<small class="text-sm">Powered by <a class="text-purple-500" href="https://kristall.app" target="_blank" rel="noopener noreferrer">Kristall</a>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: 'Quicksand Variable', sans-serif;
	}
</style>
