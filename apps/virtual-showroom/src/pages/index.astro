---
export const prerender = false;

import "@fontsource/aboreto";

import { generateTonesFromRGB, hexToRGB, rgbToHex } from '@kristall/core/utils/colors';

import { actions } from 'astro:actions';
import Layout from "../layouts/Layout.astro";

const location = Astro.url.hostname;
const shop = location.split(".")[0];
const parsedName = shop
	.split("-")
	.map((word) => word.charAt(0).toUpperCase() + word.slice(1));
const shopName = parsedName.join(" ");

const { data: virtualShowroom, error } = await Astro.callAction(actions.getVirtualShowroom, {
	shop,
});

if (!virtualShowroom || error) {
	return Astro.redirect("/404");
}

const { virtualShowroomConfig } = virtualShowroom;
const tones = generateTonesFromRGB(hexToRGB(virtualShowroomConfig?.customColor ?? '#000000'));

const customStyle = {
	"--vs-custom-500": `${rgbToHex(tones['500'])};`,
	"--vs-custom-400": `${rgbToHex(tones['400'])};`,
	"--vs-custom-300": `${rgbToHex(tones['300'])};`,
	"--vs-custom-200": `${rgbToHex(tones['200'])};`,
	"--vs-custom-100": `${rgbToHex(tones['100'])};`
}
---

<Layout style={customStyle}>
	<header class="h-20 p-6 flex items-center justify-between">
		<h1 class="text-4xl font-serif text-[var(--vs-custom-400)]">{shopName}</h1>
	</header>
	<div class="grid grid-cols-3 grid-rows-7 gap-4 px-6 py-0 self-center w-full h-[calc(100dvh-6rem)]">
		<div
			style={`background-image: url(${virtualShowroomConfig?.cardImageOne?.url})`} 
			class='bg-[var(--vs-custom-400)] col-span-3 lg:col-span-2 row-span-4 lg:row-span-7 rounded-lg p-6 flex justify-end flex-col bg-cover bg-center'>
			<h3 class="text-lg text-white">{virtualShowroomConfig?.cardTitle}</h3>
			<h4 class="font-bold text-3xl text-white text-balance max-w-[32ch]">
				{virtualShowroomConfig?.cardDescription}
			</h4>
		</div>
		<a href="/products" class="cursor-pointer group row-span-2 md:row-span-3 lg:row-span-4 col-span-3 md:col-span-2 lg:col-start-3 bg-[var(--vs-custom-300)] rounded-lg flex items-center justify-center">
			<h3 class='xl:text-4xl md:text-3xl text-2xl font-serif flex flex-col group-hover:underline'>
				<span>Ver</span>
				<div class="flex items-center gap-6">
					<span>Productos</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-right"><path d="m6 17 5-5-5-5"/><path d="m13 17 5-5-5-5"/></svg>
				</div>
			</h3>
		</a>
		<div 
			style={`background-image: url(${virtualShowroomConfig?.cardImageTwo?.url})`}
			class="bg-[var(--vs-custom-200)] md:row-span-3 lg:row-start-5 col-span-3 md:col-span-1 lg:col-start-3 bg-cover bg-center rounded-lg"></div>
	</div>
	<div class="grid grid-cols-9 grid-rows-3 lg:grid-rows-1 gap-4 px-6 pt-4 w-full font-serif h-72 lg:h-48">
		<div 
			style={`background-image: url(${virtualShowroomConfig?.cardImageThree?.url})`}
			class="bg-[var(--vs-custom-400)] col-span-3 lg:col-span-3 col-start-1 row-span-2 lg:row-span-1 rounded-lg bg-center bg-cover"></div>
		<a href="/categories" class="cursor-pointer col-span-6 lg:col-span-4 col-start-4 row-span-2 lg:row-span-1 hover:underline overflow-hidden rounded-lg p-6 grid place-content-center bg-[var(--vs-custom-100)]">
			<span class="relative z-20 md:text-3xl text-xl">Categorías</span>
		</a>
		<div
			style={`background-image: url(${virtualShowroomConfig?.cardImageFour?.url})`} 
			class="bg-[var(--vs-custom-300)] lg:col-start-8 col-span-9 lg:col-span-2 bg-cover bg-center rounded-lg"></div>
	</div>
</Layout>
