{
	"compilerOptions": {
		"target": "es2018",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": false,
		"esModuleInterop": true,
		"module": "NodeNext",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"incremental": true,
		"paths": {
			"@/*": ["./src/*"],
			"@kristall/core/*": ["./src/*"],
			"@core/*": ["./src/*"]
		},
		"outDir": "./dist",
		"declaration": true,
		"jsx": "react-jsx"
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"node_modules/next/types/**/*.ts"
	],
	"types": ["vitest/globals"],
	"exclude": ["dist", "vitest.config.ts", "**/*.test.ts", "**/*.mock.ts"]
}
