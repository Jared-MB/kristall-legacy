{
	"name": "@kristall/client",
	"version": "1.0.5",
	"description": "",
	"type": "module",
	"private": true,
	"exports": {
		"./services/store-management/use-cases/private/*": {
			"types": "./src/services/store-management/use-cases/private/*.ts",
			"default": "./dist/services/store-management/use-cases/private/*.js"
		},
		"./services/user-management/use-cases/private/*": {
			"types": "./src/services/user-management/use-cases/private/*.ts",
			"default": "./dist/services/user-management/use-cases/private/*.js"
		},
		"./services/user-management/use-cases/public/*": {
			"types": "./src/services/user-management/use-cases/public/*.ts",
			"default": "./dist/services/user-management/use-cases/public/*.js"
		},
		"./services/location-services/use-cases/private/*": {
			"types": "./src/services/location-services/use-cases/private/*.ts",
			"default": "./dist/services/location-services/use-cases/private/*.js"
		},
		"./services/analytics-tracking/use-cases/private/*": {
			"types": "./src/services/analytics-tracking/use-cases/private/*.ts",
			"default": "./dist/services/analytics-tracking/use-cases/private/*.js"
		},
		"./utils/*": {
			"types": "./src/utils/*.ts",
			"default": "./dist/utils/*.js"
		}
	},
	"scripts": {
		"dev": "tsc --watch",
		"build": "tsc"
	},
	"dependencies": {
		"@kristall/shared": "workspace:*",
		"@types/node": "^24.0.3",
		"@kristall/nexum": "workspace:*",
		"@kristall/utils": "workspace:*",
		"@kristall/logger": "workspace:*"
	},
	"devDependencies": {
		"@kristall/typescript-config": "workspace:*",
		"typescript": "5.8.3"
	},
	"peerDependencies": {
		"next": "^15",
		"react": "^19",
		"react-dom": "^19"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.1"
}
