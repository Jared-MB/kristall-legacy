{
	"name": "@kristall/client",
	"version": "1.0.9",
	"description": "",
	"type": "module",
	"private": true,
	"exports": {
		"./services/*": {
			"types": "./src/services/*.ts",
			"default": "./dist/services/*.js"
		},
		"./utils/*": {
			"types": "./src/utils/*.ts",
			"default": "./dist/utils/*.js"
		},
		"./hooks/*": {
			"types": "./src/hooks/*.ts",
			"default": "./dist/hooks/*.js"
		}
	},
	"scripts": {
		"dev": "tsc --watch",
		"build": "tsc"
	},
	"dependencies": {
		"@kristall/shared": "workspace:*",
		"@types/node": "24.0.3",
		"@kristall/nexum": "workspace:*",
		"@kristall/utils": "workspace:*",
		"@kristall/logger": "workspace:*"
	},
	"devDependencies": {
		"@kristall/typescript-config": "workspace:*",
		"typescript": "5.8.3"
	},
	"peerDependencies": {
		"next": "^15",
		"react": "^19",
		"react-dom": "^19"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.1"
}
