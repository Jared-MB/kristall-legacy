{
	"extends": "@kristall/typescript-config/base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"moduleResolution": "bundler",
		"module": "es2020"
	},
	"include": [
		"src",
		"next-env.d.ts",
		"node_modules/next/types/**/*.ts",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
