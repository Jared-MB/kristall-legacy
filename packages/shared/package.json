{
	"name": "@kristall/shared",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./domains/*/types": {
			"types": "./src/common/domains/*/types/index.ts",
