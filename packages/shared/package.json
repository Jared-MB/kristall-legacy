			"default": "./dist/common/domains/*.js"
		}
	},
	"scripts": {
		"dev": "tsc --watch",
		"build": "tsc"
	},
	"dependencies": {
		"@types/node": "^24.0.3",
		"zod": "3.25.67"
	},
	"devDependencies": {
		"@kristall/typescript-config": "workspace:*",
		"typescript": "5.8.3"
	},
	"peerDependencies": {
		"next": "^15",
		"react": "^19",
		"react-dom": "^19"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.1"
